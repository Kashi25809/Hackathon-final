# OpenAI API Key (for chat completions only - embeddings are local)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Qdrant Configuration
# Option 1: Qdrant Cloud
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# Option 2: Local Qdrant (uncomment and comment out above)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Collection Settings
QDRANT_COLLECTION_NAME=humanoid_robotics_book

# Embedding Model (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunk Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Docs Path (relative to rag-backend)
DOCS_PATH=../docs
