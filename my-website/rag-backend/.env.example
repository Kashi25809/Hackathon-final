# Gemini API Key (for embeddings and completions)
GEMINI_API_KEY=your-gemini-api-key-here

# Qdrant Cloud Configuration
QDRANT_URL=https://your-qdrant-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here

# Collection Settings
QDRANT_COLLECTION_NAME=humanoid_robotics_book

# Embedding Model (Gemini)
EMBEDDING_MODEL=models/text-embedding-004

# Chunk Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Docs Path (relative to rag-backend)
DOCS_PATH=../docs

# LLM Configuration (using Groq)
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL=llama-3.3-70b-versatile

# Neon Database Configuration
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-site.vercel.app
